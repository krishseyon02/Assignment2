#!/bin/bash

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <filename>"
  exit 1
fi

filename="$1"

# Step 1: Find max existing ID
max_id=$(awk -F";" 'NR > 1 && $1 ~ /^[0-9]+$/ && $1 > max { max = $1 } END { print max }' "$filename")

# Step 2: Process the file
awk -v max_id="$max_id" -F";" '
BEGIN {
  OFS = "\t"
  id_counter = max_id + 1
}
NR == 1 {
  for (i = 1; i <= NF; i++) {
    gsub(/\r/, "", $i)                 # Remove carriage returns in header
    gsub(/[^[:print:]]/, "", $i)       # Remove non-printable characters
  }
  print                                  # Print cleaned header
  next
}
{
  for (i = 1; i <= NF; i++) {
    gsub(/\r/, "", $i)                 # Remove Windows carriage return
    gsub(/[^[:print:]]/, "", $i)       # Remove non-ASCII characters
    gsub(",", ".", $i)                 # Convert commas to periods in decimals
  }

  # Assign a new unique ID if ID is empty
  if ($1 == "") {
    $1 = id_counter
    id_counter++
  }

  print
}
' "$filename"
