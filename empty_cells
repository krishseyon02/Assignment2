# Check for exact 2 arguments
if [ "$#" -ne 2 ]; then
  echo "Usage: $0 <filename> <delimiter>"
  exit 1
fi

# Assign input arguments
filename="$1" # input file
delimiter="$2" # field delimeter

# Get expected number of columns from header
num_cols=$(head -n 1 "$filename" | awk -F"$delimiter" '{print NF}')

# Use Awk to  Pad rows and count empty cells
awk -v FS="$delimiter" -v OFS="$delimiter" -v cols="$num_cols" '
{
  # Trim Windows carriage return
  gsub(/\r/, "")

  # Pad if fields are missing
  while (NF < cols) {
    $0 = $0 OFS
    NF++
  }

  # Store header
  if (NR == 1) {
    for (i = 1; i <= NF; i++) {
      gsub(/^\/?/, "", $i)
      colnames[i] = $i
      empty[i] = 0
    }
    next
  }

  # Count empty cells
  for (i = 1; i <= cols; i++) {
    gsub(/^ +| +$/, "", $i)
    if ($i == "") {
      empty[i]++
    }
  }
}
END {
  for (i = 1; i <= cols; i++) {
    print colnames[i] ": " empty[i]
  }
}
' "$filename"
