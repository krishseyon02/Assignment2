# Check for exact 2 arguments
if [ "$#" -ne 2 ]; then
  echo "Usage: $0 <filename> <delimiter>"
  exit 1
fi

# Assign input arguments
filename="$1" # input file
delimiter="$2" # field delimeter

# Get the number of columns from header
num_cols=$(head -n 1 "$filename" | awk -F"$delimiter" '{print NF}')

# Use Awk to  count empty cells
awk -v FS="$delimiter" -v OFS="$delimiter" -v cols="$num_cols" '
{
  # remove return characters
  gsub(/\r/, "")

  # add empty column if rows has fewer columns
  while (NF < cols) {
    $0 = $0 OFS # add one more delimeter 
    NF++
  }

  # Store header
  if (NR == 1) {
    for (i = 1; i <= NF; i++) {
      gsub(/^\/?/, "", $i)  # remove slash
      colnames[i] = $i  # saved the clean column name
      empty[i] = 0 # initialize empty counter 
    }
    next # skip to the next line 
  }

  # Count empty cells
  for (i = 1; i <= cols; i++) {
    gsub(/^ +| +$/, "", $i) # Trim spaces 
    if ($i == "") { # increment the empty counter for the column if the filed is empty
      empty[i]++
    }
  }
}
END {
# print results of column after all rows processed
  for (i = 1; i <= cols; i++) {
    print colnames[i] ": " empty[i]
  }
}
' "$filename"
